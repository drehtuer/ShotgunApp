<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Haptics on draw: the design buzzes when the countdown fires. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Portrait is a property of the design, not a default: the draw surface is
         a fixed field that players reach across from all sides, and rotating it
         mid-draw would move every finger's ring. Hence the orientation lock. -->

    <!-- The draw surface needs several simultaneous pointers to be useful. -->
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch.distinct"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shotgun">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|keyboardHidden"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:theme="@style/Theme.Shotgun">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
